# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL + anon key (safe for browser) — from Supabase Dashboard > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Never expose to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Paystack ──────────────────────────────────────────────────────────────────
# SERVER ONLY. If these are missing the app runs in clearly-labelled TEST MODE:
# checkout is simulated, no real money moves, tickets are marked test-only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Public base URL of this deployment (used for Paystack callbacks + links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email ─────────────────────────────────────────────────────────────────────
# SERVER ONLY. If RESEND_API_KEY is missing, emails are logged to the server
# console instead of being sent — nothing is ever faked as "delivered".
EMAIL_FROM="JaiyePass <no-reply@jaiyepass.com>"
RESEND_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# Secret used to HMAC-hash ticket tokens at rest (any long random string)
TICKET_TOKEN_PEPPER=
