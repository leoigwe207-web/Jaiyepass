{
  "name": "jaiyepass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && npm run test && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node scripts/check-release-env.cjs",
    "build:next": "next build",
    "prebuild": "node -e \"const l=require('./package-lock.json');const x=Object.fromEntries(Object.entries(l.packages).filter(([k])=>/^node_modules\\/(?:gsap|lenis|motion(?:-dom|-utils)?|@motionone\\/.+)$/.test(k)));console.log('UI_LOCK_SNAPSHOT='+JSON.stringify(x));\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.58.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "next": "^15.5.4",
    "posthog-js": "1.438.13",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "motion": "^14.9.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.7.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
